DATABASE_URL="file:./dev.db"
# On Vercel set DATABASE_URL to a pooled Postgres connection string:
# postgresql://user:password@host/database?sslmode=require
# DIRECT_URL is optional; this project uses a separate Postgres schema + migration and does not require it for the configured flow.

JWT_SECRET="change-me-in-production-please-use-long-random"
JWT_EXPIRES_IN="7d"

# Optional: leave OPENAI_API_KEY empty to use the deterministic fallback.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL=""

PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
