{
  "name": "bookleaf-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "prisma migrate dev --name init",
    "generate": "prisma generate",
    "seed": "node src/seed/index.js",
    "build:deploy": "npx prisma generate --schema=prisma/production/schema.postgres.prisma && npx prisma migrate deploy --schema=prisma/production/schema.postgres.prisma",
    "studio": "prisma studio",
    "verify:dataset": "node scripts/verify-dataset.js",
    "start:prod": "node src/index.js",
    "test": "node --test test/api.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.56.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0"
  }
}
